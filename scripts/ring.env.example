# Settings for ring-up.sh / ring-down.sh. Copy to ring.env next to the scripts and edit.
# Run the scripts on node0 (the head, TP rank 0). The other nodes are reached over SSH.

# SSH names of the four nodes in TP rank order (not ring order). The first one is the head, the machine you run the scripts on.
RING_HOSTS="node0 node1 node2 node3"
# SSH user on every node (it must be able to run systemctl, docker, modprobe, devlink).
SSH_USER=root

# Checkout of the recipe fork on node0.
RECIPE_DIR=/opt/recipe
# Env files inside RECIPE_DIR: the mesh serve config and the plain-ring serve config.
ENV_MESH=.env.tp4.mesh
ENV_PLAIN=.env.tp4.plain

# RDMA devices whose GID index 3 must be the IPv4 GID (two per PCI domain, two domains).
RDMA_DEVS="rocep1s0f0 rocep1s0f1 roceP2p1s0f0 roceP2p1s0f1"

# systemd unit that installs the hairpin queue size, routes, tc rules and markers on each node.
MESH_UNIT=dsv41-mesh

# Docker container that exports the weights over NFS, and the nodes that run it (if you use NFS_SHARE).
# Leave NFS_EXPORTER_HOSTS empty if you do not export weights over NFS.
NFS_CONTAINER=dsv41-nfs
NFS_EXPORTER_HOSTS="node0 node3"
# Optional check: mount NFS_CHECK_SERVER:/ read-only on NFS_CHECK_HOST and count the *safetensors* files.
NFS_CHECK_HOST=node2
NFS_CHECK_SERVER=10.60.3.1
NFS_EXPECTED_FILES=49

# Optional command run on every node before serve to drop page cache (leave empty to skip).
MEMCLEAN_CMD=""

# Where the scripts write their serve and smoke logs on node0.
LOG_DIR=/var/tmp
